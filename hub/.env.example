APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_CIPHER=AES-256-CBC
APP_PREVIOUS_KEYS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Hub learning content and runtime URLs.
# LABS_CONTENT_PATH points to the static portal JSON content directory.
# HUB_RUNTIME_BASE_URL is used by generated curl/smoke-check commands.
# HUB_PORT is the host port used by Docker Compose.
# HUB_INTERNAL_PORT is the port Laravel serves inside the container.
LABS_CONTENT_PATH=../data
HUB_RUNTIME_BASE_URL=http://localhost:8088
HUB_PORT=8088
HUB_INTERNAL_PORT=8088

# Configuration-practice artifact IDs.
# Override these if your team uses private ticket, ADR, incident, or archive names.
CONFIGURATION_ARCHIVE_PREFIX=configuration-contract
CONFIGURATION_SESSION_ARCHIVE_SUFFIX=session-debrief
CONFIGURATION_DECISION_RECORD_ID=ADR-CONFIG-001
CONFIGURATION_RUNBOOK_ID=RUNBOOK-CONFIG-001
CONFIGURATION_INCIDENT_ID=INC-CONFIG-001
CONFIGURATION_POSTMORTEM_ID=POSTMORTEM-CONFIG-001
CONFIGURATION_INCIDENT_ROOT_CAUSE="A configuration contract changed without updating every dependent readiness and evidence artifact."

# Authentication contract defaults used by config/auth.php.
AUTH_GUARD=web
AUTH_PASSWORD_BROKER=users
AUTH_MODEL=App\Models\User
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_RESET_EXPIRE=60
AUTH_PASSWORD_RESET_THROTTLE=60
AUTH_PASSWORD_TIMEOUT=10800

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_STDERR_FORMATTER=null
LOG_SYSLOG_FACILITY=LOG_USER
LOG_SLACK_USERNAME="${APP_NAME}"
LOG_SLACK_EMOJI=:boom:
LOG_PAPERTRAIL_HANDLER=SyslogUdpHandler

DB_CONNECTION=sqlite
DB_URL=null
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true
DB_SSLMODE=prefer
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=false
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_CONNECTION=null
SESSION_TABLE=sessions
SESSION_STORE=null
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
DB_QUEUE_CONNECTION=null
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
BEANSTALKD_QUEUE_HOST=localhost
BEANSTALKD_QUEUE=default
BEANSTALKD_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=file
DB_CACHE_CONNECTION=null
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=null
DB_CACHE_LOCK_TABLE=cache_locks
CACHE_STORAGE_DISK=local
CACHE_STORAGE_PATH=cache
CACHE_PREFIX=
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=

MEMCACHED_PERSISTENT_ID=
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=null
MEMCACHED_PASSWORD=null

REDIS_CLIENT=phpredis
REDIS_CLUSTER=redis
REDIS_PREFIX=
REDIS_PERSISTENT=false
REDIS_URL=null
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_QUEUE=default
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_URL=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=null
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_LOG_CHANNEL=null
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

SQS_PREFIX=
SQS_QUEUE=default
SQS_SUFFIX=

SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=
LOG_SLACK_WEBHOOK_URL=
PAPERTRAIL_URL=
PAPERTRAIL_PORT=

VITE_APP_NAME="${APP_NAME}"
